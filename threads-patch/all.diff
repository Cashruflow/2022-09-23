+  display: grid; place-items: center; border: 2px solid var(--ui-card-bg); color: var(--ui-btn1-text, #fff); background: var(--ui-brand); }
+.dc-ch > svg { width: 11px; height: 11px; fill: none; stroke: currentColor; }
+.dc-ch.is-wa { background: var(--ui-ok); }
+.dc-ch.is-max { background: var(--ui-warn); }
+
+/* счётчик во вкладке — число, не тревога: приглушённо, не .ui-badge */
+.dc-n { font-size: 11.5px; font-weight: 600; color: var(--ui-tx-3); font-variant-numeric: tabular-nums; }
+.dc-n:empty { display: none; }
+.ui-tab.is-on .dc-n { color: inherit; opacity: .7; }
+
+/* «Показать ещё · осталось N» и заметки внутри списка */
+.dc-more { display: flex; justify-content: center; padding: 10px 8px 6px; }
+.dc-note { margin: 6px 8px; padding: 10px 12px; border-radius: 12px; font-size: 12.5px; line-height: 1.45;
+  color: var(--ui-tx-2); background: var(--ui-surface-3, var(--ui-surface-2)); }
+.dc-note a { color: var(--ui-brand); }
+.dc-err { color: var(--ui-danger); }
+.dc-sk { display: flex; gap: 12px; padding: 12px; }
+.dc-sk .ui-sk { margin: 4px 0; }
+
+/* ---------- превью ---------- */
+.dc-pv-h { flex: 0 0 auto; padding: 18px 20px 16px; border-bottom: 1px solid var(--ui-line-2); }
+.dc-pv-src { --fx-gap: 8px; font-size: 12.5px; color: var(--ui-tx-2); min-width: 0; }
+.dc-pv-t { margin: 10px 0 0; font-size: 22px; font-weight: 700; letter-spacing: -.01em; line-height: 1.25; overflow-wrap: anywhere; }
+.dc-pv-ppl { --fx-gap: 10px; margin-top: 10px; font-size: 13px; color: var(--ui-tx-2); flex-wrap: wrap; }
+.dc-avs { display: flex; }
+.dc-avs > .dc-av { --s: 28px; font-size: 10.5px; border: 2px solid var(--ui-card-bg); margin-left: -8px; }
+.dc-avs > .dc-av:first-child { margin-left: 0; }
+.dc-pv .ui-tiles, .dc-sheet .ui-tiles { margin-top: 14px; }
+.dc-pv-b { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 6px 20px 8px; }
+.dc-pv-f { flex: 0 0 auto; padding: 12px 20px 16px; border-top: 1px solid var(--ui-line-2); font-size: 12.5px; color: var(--ui-tx-2); }
+.dc-pv-f > span { flex: 1 1 auto; min-width: 0; }
+
+/* сообщение: аватар и линия ветки слева */
+.dc-msg-it { display: flex; gap: 12px; }
+.dc-msg-l { display: flex; flex-direction: column; align-items: center; flex: 0 0 36px; }
+.dc-msg-l > .dc-av { --s: 36px; }
+.dc-msg-l > i { flex: 1 1 auto; width: 2px; margin: 6px 0 2px; border-radius: 2px; background: var(--ui-line); }
+.dc-msg-it:last-child .dc-msg-l > i { display: none; }
+.dc-msg-b { flex: 1 1 auto; min-width: 0; padding: 12px 0 14px; }
+.dc-msg-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-size: 13px; color: var(--ui-tx-3); }
+.dc-msg-h > b { font-size: 14px; font-weight: 600; color: var(--ui-tx); }
+.dc-role { font-size: 11.5px; padding: 0 6px; border-radius: 6px; background: var(--ui-surface-2); color: var(--ui-tx-2); }
+.dc-role.is-int { background: var(--ui-warn-soft); color: var(--ui-warn-soft-tx); }
+.dc-msg-t { margin-top: 3px; font-size: 14px; line-height: 1.5; color: var(--ui-tx); white-space: pre-wrap; overflow-wrap: anywhere; }
+.dc-msg-t a.cf-link { color: var(--ui-brand); }
+.dc-new { display: flex; align-items: center; gap: 10px; margin: 6px 0 2px; font-size: 11px; font-weight: 600; letter-spacing: .08em;
+  text-transform: uppercase; color: var(--ui-brand-soft-tx); }
+.dc-new::before, .dc-new::after { content: ""; flex: 1 1 auto; height: 1px; background: var(--ui-brand-soft-line); }
+
+/* превью в шторке (<1100px): тело — тот же разбор, без кнопок (действия — иконками в .mdl-acts) */
+.dc-sheet .dc-pv-src { margin-bottom: 4px; }
+.dc-sheet .dc-pv-t { font-size: 19px; margin-top: 6px; }
+
+/* ---------- телефон (M-77: шапка .ph + поиск .lt-find; список — карточка как .ui-ios-card) ---------- */
+@media (max-width: 768px) {
+  .dc-grid { margin-top: 12px; }
+  .dc-list { width: 100%; padding: 4px 0; }
+  .dc-row { border-radius: 0; padding: 11px 14px; }
+  .dc-row::after { left: 70px; right: 14px; }
+  .dc-row.is-sel { box-shadow: none; }
+  .dc-t { font-size: 16px; }
+  .dc-msg { font-size: 14px; }
+  .dc-cap { padding-left: 16px; }
+  .dc-pv-h { padding: 4px 0 12px; }
+  .dc-pv-b { padding: 4px 0 8px; overflow: visible; }
+}
