+.dc-msg { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13.5px; color: var(--ui-tx-2); }
+.dc-msg > svg { width: 14px; height: 14px; vertical-align: -2px; margin-right: 3px; fill: none; stroke: currentColor; }
+.dc-row.is-unread .dc-msg { color: var(--ui-tx); }
+.dc-m > .ui-badge { margin-left: 0; }
+.dc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 3px; font-size: 12px; color: var(--ui-tx-3); }
+.dc-meta > span { display: inline-flex; align-items: center; gap: 4px; }
+.dc-meta svg { width: 14px; height: 14px; fill: none; stroke: currentColor; }
+/* пост ленты: две строки текста */
+.dc-post { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.42; color: var(--ui-tx); }
+
+/* ---------- аватары-инициалы: оттенок от имени, как .sv2-fav (seo-v2.css); в токенах палитры аватаров нет ---------- */
+.dc-av { --s: 44px; position: relative; flex: 0 0 auto; width: var(--s); height: var(--s); border-radius: 50%; box-sizing: border-box;
+  display: inline-grid; place-items: center; font-size: calc(var(--s) * .36); font-weight: 600; letter-spacing: .01em;
+  color: var(--ui-btn1-text, #fff); background: hsl(var(--h, 210) 55% 44%); }
