--- /dev/null
+++ b/web/public/discuss_page.js
@@ -0,0 +1,411 @@
+/* discuss_page.js — страница «Треды» (/discuss, 26.10.2026).
+ * Данные: GET /api/discuss/list (список, фильтр и поиск — на сервере, ui.md «Фильтры реестров считаются
+ * на сервере») и GET /api/discuss/item (превью; прочитанным ничего не отмечает). Писать здесь нечего:
+ * ответ в тред — в исходной карточке, кнопка «Открыть».
+ * ПК ≥1101px — список слева, превью справа (липкое); ≤1100 — превью шторкой .mdl-back.mdl-right
+ * (на телефоне ui.css делает её нижним листом). Состояние — в адресе: ?type=&q=&id= (общий набор
+ * GET-параметров, data.md). Поиск — «/», как на /issues и /ticket (Ctrl/⌘+K оставлен меню). */
+(function () {
+  'use strict';
+
+  var TYPES = ['all', 'talks', 'feed', 'chats'];
+  var MQ_ONE = window.matchMedia ? window.matchMedia('(max-width:1100px)') : null;   // одна колонка — превью шторкой
+  var MQ_MOB = window.matchMedia ? window.matchMedia('(max-width:768px)') : null;
+  var S = { type: 'all', q: '', items: [], next: null, counts: null, unread: null, awaiting: 0, feed: '', access: null,
+    sel: '', seq: 0, pvSeq: 0, busy: false, err: null, sheet: null };
+
+  // ---------- мелочи ----------
+  function $(id) { return document.getElementById(id); }
+  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+  function spr() { return window.ICONS_URL || '/assets/icons.svg?v=31'; }
+  function ico(id, cls) { return '<svg' + (cls ? ' class="' + cls + '"' : '') + ' aria-hidden="true"><use href="' + spr() + '#' + id + '"></use></svg>'; }
+  function hue(s) { var h = 7; s = String(s || ''); for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360; return h; }
+  function initials(n) {
+    n = String(n || '').replace(/^@+/, '').trim();
+    if (!n) return '·';
+    var w = n.split(/[\s._-]+/).filter(Boolean);
+    return (w.length > 1 ? w[0].charAt(0) + w[1].charAt(0) : n.slice(0, 2)).toUpperCase();
+  }
+  function av(name, extra) { return '<span class="dc-av" style="--h:' + hue(name) + '">' + esc(initials(name)) + (extra || '') + '</span>'; }
+  function plural(n, a, b, c) { var m = Math.abs(n) % 100, k = m % 10; return m > 10 && m < 20 ? c : k === 1 ? a : k > 1 && k < 5 ? b : c; }
+  function isOne() { return !!(MQ_ONE && MQ_ONE.matches); }
+  function isMob() { return !!(MQ_MOB && MQ_MOB.matches); }
+  function toast(t, err) {
+    if (typeof window.pltToast === 'function') window.pltToast(t, { err: !!err, ms: err ? 5000 : 3000 });
+    else if (typeof window.uiToast === 'function') window.uiToast(t);
+  }
+  // локальное время (ADR-093): сегодня — «14:32», вчера — «вчера», неделя — «пн», иначе «26.10»
+  var WD = ['вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];
+  function dayKey(d) { return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }
+  function dayDiff(d) {
+    var a = new Date(d.getFullYear(), d.getMonth(), d.getDate()), n = new Date(), b = new Date(n.getFullYear(), n.getMonth(), n.getDate());
+    return Math.round((b - a) / 86400000);
+  }
+  function hm(d) { return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
+  function dm(d) { return String(d.getDate()).padStart(2, '0') + '.' + String(d.getMonth() + 1).padStart(2, '0'); }
+  function short(iso) {
+    var d = new Date(iso); if (isNaN(d)) return '';
+    var k = dayDiff(d);
+    return k <= 0 ? hm(d) : k === 1 ? 'вчера' : k < 7 ? WD[d.getDay()] : dm(d);
+  }
+  function long(iso) {
+    var d = new Date(iso); if (isNaN(d)) return '';
+    var k = dayDiff(d);
+    return (k <= 0 ? 'сегодня' : k === 1 ? 'вчера' : k < 7 ? WD[d.getDay()] : dm(d)) + ', ' + hm(d);
+  }
+  function group(iso) {
+    var d = new Date(iso); if (isNaN(d)) return 'Раньше';
+    var k = dayDiff(d);
+    return k <= 0 ? 'Сегодня' : k === 1 ? 'Вчера' : k < 7 ? 'На этой неделе' : 'Раньше';
+  }
+
+  // ---------- запросы: r.ok ДО разбора; сеть, 401/403, ошибка сервера и «пришла страница» — разные тексты (ui.md) ----------
+  function api(url) {
+    return fetch(url, { credentials: 'same-origin' }).catch(function () {
+      var e = new Error('Нет связи с сервером — проверь соединение и повтори'); e.kind = 'net'; throw e;
+    }).then(function (r) {
+      return r.text().then(function (t) {
+        var d = null;
+        try { d = t ? JSON.parse(t) : {}; } catch (x) { d = null; }
+        if (r.status === 401) { var e1 = new Error('Сессия истекла — войди заново'); e1.kind = 'auth'; throw e1; }
+        if (r.status === 403) { var e3 = new Error((d && d.error) || 'Раздел закрыт для вашей роли'); e3.kind = 'deny'; throw e3; }
+        if (!r.ok) { var e2 = new Error((d && d.error) || ('Сервер ответил ошибкой ' + r.status)); e2.kind = r.status === 422 ? 'gone' : 'http'; e2.status = r.status; throw e2; }
+        if (!d) { var e4 = new Error('Вместо данных пришла страница — покажи этот экран разработчику'); e4.kind = 'html'; throw e4; }
+        return d;
+      });
+    });
+  }
+
+  // ---------- адрес ----------
+  function readUrl() {
+    var p = new URLSearchParams(location.search);
+    var t = p.get('type') || 'all';
+    S.type = TYPES.indexOf(t) >= 0 ? t : 'all';
+    S.q = (p.get('q') || '').slice(0, 100);
+    S.sel = (p.get('id') || '').slice(0, 60);
+  }
+  function writeUrl() {
+    var p = new URLSearchParams();
+    if (S.type !== 'all') p.set('type', S.type);
+    if (S.q) p.set('q', S.q);
+    if (S.sel) p.set('id', S.sel);
+    var u = location.pathname + (p.toString() ? '?' + p.toString() : '');
+    try { history.replaceState(null, '', u); } catch (e) { /* адрес — удобство, не данные */ }
+  }
+
+  // ---------- список ----------
+  function listUrl(cursor) {
+    var p = new URLSearchParams();
+    p.set('type', S.type);
+    if (S.q) p.set('q', S.q);
+    if (cursor) p.set('cursor', cursor);
+    return '/api/discuss/list?' + p.toString();
+  }
+  function load(more) {
+    var seq = ++S.seq;
+    S.busy = true;
+    if (!more) { S.err = null; paintSkeleton(); }
+    return api(listUrl(more ? S.next : '')).then(function (d) {
+      if (seq !== S.seq) return;
+      S.items = more ? S.items.concat(d.items || []) : (d.items || []);
+      S.next = d.next_cursor || null;
+      S.counts = d.counts || null; S.unread = d.unread || null; S.awaiting = +d.awaiting || 0;
+      S.feed = d.feed_state || ''; S.access = d.access || null; S.err = null;
+    }, function (e) {
+      if (seq !== S.seq) return;
+      if (more) toast(e.message, true); else S.err = e;
+    }).then(function () {
+      if (seq !== S.seq) return;
+      S.busy = false;
+      paintList(); paintTabs(); paintSub();
+      if (!more && !isOne()) {
+        // ПК: превью первой строки, если в адресе ничего не выбрано или выбранного нет в списке
+        if (!S.sel || !S.items.some(function (x) { return x.id === S.sel; })) S.sel = S.items.length ? S.items[0].id : S.sel;
+        if (S.sel) openPreview(S.sel, true); else paintPreviewEmpty();
+      }
+    });
+  }
+
+  function paintSkeleton() {
+    var el = $('dc-list'); if (!el) return;
+    el.setAttribute('aria-busy', 'true');
+    var row = '<div class="dc-sk"><span class="dc-av is-ico"></span><span class="fx-grow"><span class="ui-sk"></span><span class="ui-sk"></span></span></div>';
+    el.innerHTML = row + row + row + row;
+  }
+
+  function paintSub() {
+    var el = $('dc-sub'); if (!el) return;
