+.dc-list { flex: 0 0 auto; width: min(548px, 46%); min-width: 0; box-sizing: border-box; padding: 4px;
+  background: var(--ui-card-bg); border: 1px solid var(--ui-card-border); border-radius: var(--ui-radius-lg, 24px); }
+.dc-pv { flex: 1 1 0; min-width: 0; box-sizing: border-box; position: sticky; top: var(--dc-top);
+  max-height: calc(100dvh - var(--dc-top) - 24px); display: flex; flex-direction: column; overflow: hidden;
+  background: var(--ui-card-bg); border: 1px solid var(--ui-card-border); border-radius: var(--ui-radius-lg, 24px); }
+.dc-pv:empty { display: none; }
+@media (max-width: 1100px) {
+  /* одна колонка: превью открывается шторкой справа (.mdl-back.mdl-right) */
+  .dc-list { width: 100%; }
+  .dc-pv { display: none; }
+}
+
+/* подпись группы по дню */
+.dc-cap { padding: 14px 14px 6px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ui-tx-3); }
+.dc-cap:first-child { padding-top: 10px; }
+
+/* ---------- строка треда (кнопка без ролевых классов — btnCss её не трогает) ---------- */
+.dc-row { position: relative; display: flex; gap: 12px; width: 100%; box-sizing: border-box; margin: 0; padding: 11px 12px;
+  border: 0; border-radius: 16px; background: transparent; color: var(--ui-tx); font: inherit; text-align: left; cursor: pointer;
+  -webkit-tap-highlight-color: transparent; }
+.dc-row::after { content: ""; position: absolute; left: 68px; right: 12px; bottom: 0; height: 1px; background: var(--ui-line-2); }
+.dc-row:last-child::after, .dc-row:has(+ .dc-cap)::after, .dc-row:has(+ .dc-more)::after, .dc-row.is-sel::after { display: none; }
