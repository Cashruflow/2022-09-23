+.dc-av.is-ico > svg { width: 22px; height: 22px; fill: none; stroke: currentColor; }
+.dc-stack { position: relative; flex: 0 0 auto; width: 44px; height: 44px; }
+.dc-stack > .dc-av { --s: 30px; position: absolute; border: 2px solid var(--ui-card-bg); font-size: 11px; }
+.dc-stack > .dc-av:first-child { left: 0; top: 0; }
